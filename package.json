{
  "name": "@out-box/mcp",
  "version": "0.3.0",
  "mcpName": "dev.out-box/mcp",
  "description": "MCP server oficial de Outbox (out-box.dev) — publicar, leer y gestionar HTMLs en tu biblioteca agents-first desde cualquier cliente MCP.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "outbox-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run clean && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanleiva15/out-box-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jonathanleiva15/out-box-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "outbox",
    "out-box.dev",
    "agents"
  ],
  "license": "MIT",
  "author": "Jonathan Leiva <jonathanleiva15@gmail.com> (https://out-box.dev)",
  "homepage": "https://out-box.dev",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
